generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
}

model role {
  id    Int    @id @default(autoincrement())
  name  String @unique
  users user[]
}

model user {
  id         Int          @id @default(autoincrement())
  roleId     Int
  name       String       @db.VarChar(100)
  alamat     String?      @db.VarChar(255)
  noHp       String?      @db.VarChar(13)
  email      String?      @unique
  password   String?
  image      String?
  createdAt  DateTime     @default(now())
  updatedAt  DateTime     @updatedAt
  pengiriman pengiriman[]
  pesanan    pesanan[]
  role       role         @relation(fields: [roleId], references: [id])
}

model harga {
  id         Int       @id @default(autoincrement())
  provinsi   String    @db.VarChar(100)
  kota       String    @db.VarChar(100)
  hargaTarif Decimal   @db.Decimal(10, 2)
  createdAt  DateTime  @default(now())
  updatedAt  DateTime  @updatedAt
  pesanan    pesanan[]
}

model truck {
  id         Int          @id @default(autoincrement())
  platNomor  String       @unique @db.VarChar(20)
  kondisi    String?      @db.VarChar(50)
  status     String       @default("AKTIF") @db.VarChar(50)
  createdAt  DateTime     @default(now())
  updatedAt  DateTime     @updatedAt
  pengiriman pengiriman[]
}

model pesanan {
  id              Int         @id @default(autoincrement())
  userId          Int
  hargaId         Int?
  pengirimanId    Int?
  noSpb           String
  koli            Int
  berat           Int
  hargaCustom     Decimal?    @db.Decimal(10, 2)
  tujuan          String      @db.VarChar(255)
  ket             String?     @db.VarChar(255)
  prioritas       String      @db.VarChar(50)
  statusPay       String?     @default("Belum Lunas")
  jenisPengiriman String      @default("REGULER")
  total           Decimal     @db.Decimal(10, 2)
  tanggalMasuk    DateTime    @default(now())
  image           String?
  createdAt       DateTime    @default(now())
  updatedAt       DateTime    @updatedAt
  pengiriman      pengiriman? @relation(fields: [pengirimanId], references: [id])
  harga           harga?      @relation(fields: [hargaId], references: [id])
  user            user        @relation(fields: [userId], references: [id])
}

model pengiriman {
  id               Int           @id @default(autoincrement())
  truckId          Int
  name             String?
  kapasitas        Decimal       @db.Decimal(10, 2)
  bb               Decimal       @db.Decimal(10, 2)
  totalHarga       Decimal       @db.Decimal(10, 2)
  totalBerat       Decimal       @db.Decimal(10, 2)
  tanggalJalan     DateTime
  statusPengiriman String        @db.VarChar(50)
  createdAt        DateTime      @default(now())
  updatedAt        DateTime      @updatedAt
  pesanan          pesanan[]
  sopir            user[]
  truck            truck         @relation(fields: [truckId], references: [id])
  pengeluaran      pengeluaran[]
}

model pengeluaran {
  id           Int         @id @default(autoincrement())
  pengirimanId Int?
  nama         String      @db.VarChar(100)
  kategori     String      @db.VarChar(255)
  nominal      Decimal     @db.Decimal(10, 2)
  keterangan   String?     @db.VarChar(255)
  createdAt    DateTime    @default(now())
  updatedAt    DateTime    @updatedAt
  pengiriman   pengiriman? @relation(fields: [pengirimanId], references: [id])
}

